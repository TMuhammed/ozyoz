{
  "manifest_version": 3,
  "name": "Özyoz",
  "version": "0.1.0",
  "description": "Yozganingizda yangi özbek lotin alifbosiga ötkazadi: sh→ş, ch→ç, oʻ→ö, gʻ→ğ. Hammasi lokal, heç narsa yuborilmaydi.",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Özyoz"
  },
  "options_page": "src/options/index.html",
  "omnibox": {
    "keyword": "uz"
  },
  "background": {
    "service_worker": "src/browser/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "search"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser/content-script.ts"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
