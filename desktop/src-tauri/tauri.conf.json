{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Özyoz",
  "version": "0.1.0",
  "identifier": "uz.ozyoz.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Özyoz",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Özyoz"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Yangi özbek alifbosiga avtomatik ötkaziş",
    "longDescription": "Özyoz istalgan dasturda yozayotganingizda sh→ş, ch→ç, oʻ→ö, gʻ→ğ almaştiradi. Hammasi lokal.",
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": [] } }
  }
}
